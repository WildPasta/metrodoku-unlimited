{
  "manifest_version": 3,
  "name": "Metrodoku Unlimited",
  "version": "1.0.0",
  "description": "Affiche les pourcentages de rareté par station sur les grilles archivées de Métrodoku.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://metrodoku.fr/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://metrodoku.fr/*"
  ]
}
